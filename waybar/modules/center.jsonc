{
    "modules-center": ["hyprland/workspaces"],

    "hyprland/workspaces": {
	"format": "{icon}",
	"format-icons": {
            "active":     "󰮯",
            "empty":      "󱙝",  
            "default":    "󰊠"   
	},
        "persistent-workspaces": {
            "*": [1, 2, 3,4,5]
        },
        "persistent-only": false , 
	"all-outputs": false,
	"show-special": true,
	"special-visible-only": true,
	"disable-scroll": false,
        "on-click": "activate",
	"sort-by": "number"
    },
 } , 

